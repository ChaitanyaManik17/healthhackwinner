# Copy to .env and fill in. Never commit .env.

# AWS (from the Workshop Studio "Get AWS CLI credentials" panel; they expire, refresh when calls fail)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock model used by the classifier (Chaitanya confirms the final choice in docs/decisions.md)
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Backend
TICKETS_TABLE=call-bell-tickets
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
