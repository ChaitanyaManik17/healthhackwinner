{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChaitanyaManik17/healthhackwinner/ai/ticket.schema.json",
  "title": "Call Bell Router ticket",
  "description": "Exact ticket contract from the team plan, including category routing invariants. Uncertain requests must use the unclear category.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id", "room", "raw_text", "language", "category", "department",
    "priority", "confidence", "escalate_to_nurse", "reason", "status", "created_at"
  ],
  "properties": {
    "ticket_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "room": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "raw_text": { "type": "string" },
    "language": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "category": {
      "type": "string",
      "enum": ["housekeeping", "food", "tech", "urgent_clinical", "unclear"]
    },
    "department": {
      "type": "string",
      "enum": ["housekeeping", "food", "unit_clerk_it", "nurse"]
    },
    "priority": { "type": "string", "enum": ["low", "normal", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "escalate_to_nurse": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "status": { "type": "string", "enum": ["new", "acknowledged", "done"] },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?([Zz]|\\+00:00)$",
      "description": "RFC 3339 calendar timestamp in UTC, using Z or +00:00. Leap seconds are not accepted by this contract."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "housekeeping" } }, "required": ["category"] },
      "then": { "properties": {
        "department": { "const": "housekeeping" }, "priority": { "const": "normal" },
        "escalate_to_nurse": { "const": false }
      } }
    },
    {
      "if": { "properties": { "category": { "const": "food" } }, "required": ["category"] },
      "then": { "properties": {
        "department": { "const": "food" }, "priority": { "const": "normal" },
        "escalate_to_nurse": { "const": false }
      } }
    },
    {
      "if": { "properties": { "category": { "const": "tech" } }, "required": ["category"] },
      "then": { "properties": {
        "department": { "const": "unit_clerk_it" }, "priority": { "const": "low" },
        "escalate_to_nurse": { "const": false }
      } }
    },
    {
      "if": { "properties": { "category": { "enum": ["urgent_clinical", "unclear"] } }, "required": ["category"] },
      "then": { "properties": {
        "department": { "const": "nurse" }, "priority": { "const": "high" },
        "escalate_to_nurse": { "const": true }
      } }
    }
  ]
}
